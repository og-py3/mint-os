#!/usr/bin/env bash
# =============================================================================
# Mint OS — mint-dash  |  Live system telemetry dashboard
# GPU-style real-time metrics with mint-green aesthetic
# =============================================================================
set -euo pipefail

MINT='\033[38;2;46;203;113m'; BOLD='\033[1m'; NC='\033[0m'
DIM='\033[2m'; CYAN='\033[0;36m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
G2='\033[38;2;46;203;113m'   # mint bright
G1='\033[38;2;30;130;70m'    # mint mid
G0='\033[38;2;15;65;35m'     # mint dark
BLK='\033[38;2;20;32;20m'    # near-black

INTERVAL="${1:-1}"  # refresh interval in seconds

# ── Bar Generator ─────────────────────────────────────────────────────────────
bar() {
    local pct="$1"
    local width="${2:-30}"
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    local color

    if   (( pct > 90 )); then color="${RED}"
    elif (( pct > 75 )); then color="${YELLOW}"
    else                       color="${MINT}"
    fi

    local result="${color}"
    local i
    for (( i=0; i<filled; i++ )); do result+="█"; done
    result+="${DIM}"
    for (( i=0; i<empty; i++ ));  do result+="░"; done
    result+="${NC}"
    echo -n -e "$result"
}

# ── Sparkline from history array ──────────────────────────────────────────────
declare -a CPU_HIST=()
declare -a MEM_HIST=()
declare -a NET_RX_HIST=()

sparkline() {
    local -n arr=$1
    local chars=("▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")
    local len="${#arr[@]}"
    local out=""
    for (( i=0; i<len && i<20; i++ )); do
        local v="${arr[$i]}"
        (( v > 100 )) && v=100
        local idx=$(( v * 7 / 100 ))
        out+="${chars[$idx]}"
    done
    echo -n "$out"
}

# ── Data Collectors ───────────────────────────────────────────────────────────
get_cpu() {
    local cpu_line
    cpu_line=$(grep "cpu " /proc/stat)
    local user system idle iowait irq softirq steal
    read -r _ user _ system idle iowait irq softirq steal _ <<< "$cpu_line"
    local total=$(( user + system + idle + iowait + irq + softirq + steal ))
    local used=$(( total - idle - iowait ))
    if [[ -n "${PREV_CPU_TOTAL:-}" ]]; then
        local dt=$(( total - PREV_CPU_TOTAL ))
        local du=$(( used - PREV_CPU_USED ))
        (( dt > 0 )) && echo $(( du * 100 / dt )) || echo "0"
    else
        echo "0"
    fi
    PREV_CPU_TOTAL=$total
    PREV_CPU_USED=$used
}

get_gpu_usage() {
    # NVIDIA
    if command -v nvidia-smi &>/dev/null; then
        nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 || echo "N/A"
    # AMD
    elif [[ -f /sys/class/drm/card0/device/gpu_busy_percent ]]; then
        cat /sys/class/drm/card0/device/gpu_busy_percent
    else
        echo "N/A"
    fi
}

get_gpu_vram() {
    if command -v nvidia-smi &>/dev/null; then
        nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | \
            awk -F', ' '{printf "%.0f", $1/$2*100}' || echo "N/A"
    elif [[ -f /sys/class/drm/card0/device/mem_info_vram_used ]]; then
        local used total
        used=$(cat /sys/class/drm/card0/device/mem_info_vram_used 2>/dev/null || echo 0)
        total=$(cat /sys/class/drm/card0/device/mem_info_vram_total 2>/dev/null || echo 1)
        echo $(( used * 100 / total ))
    else
        echo "N/A"
    fi
}

get_net_speed() {
    local iface
    iface=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'dev \K\S+' | head -1 || echo "lo")
    local rx tx
    rx=$(cat "/sys/class/net/${iface}/statistics/rx_bytes" 2>/dev/null || echo "0")
    tx=$(cat "/sys/class/net/${iface}/statistics/tx_bytes" 2>/dev/null || echo "0")
    if [[ -n "${PREV_RX:-}" ]]; then
        local drx=$(( (rx - PREV_RX) / 1024 ))
        local dtx=$(( (tx - PREV_TX) / 1024 ))
        echo "$drx $dtx $iface"
    else
        echo "0 0 $iface"
    fi
    PREV_RX=$rx
    PREV_TX=$tx
}

format_bytes() {
    local kb="$1"
    if   (( kb >= 1048576 )); then printf "%.1fGB" "$(echo "scale=1; $kb/1048576" | bc)"
    elif (( kb >= 1024 ));    then printf "%.1fMB" "$(echo "scale=1; $kb/1024" | bc)"
    else                           printf "${kb}KB"
    fi
}

# ── Main Dashboard Loop ────────────────────────────────────────────────────────
dashboard() {
    tput civis  # hide cursor
    trap 'tput cnorm; echo ""; exit 0' INT TERM

    # Initialize prev values
    PREV_CPU_TOTAL=0; PREV_CPU_USED=0; PREV_RX=0; PREV_TX=0

    while true; do
        # Collect data
        CPU=$(get_cpu)
        MEM_TOTAL=$(grep MemTotal /proc/meminfo | awk '{print $2}')
        MEM_AVAIL=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
        MEM_USED=$(( MEM_TOTAL - MEM_AVAIL ))
        MEM_PCT=$(( MEM_USED * 100 / MEM_TOTAL ))
        MEM_GB=$(echo "scale=1; $MEM_USED/1048576" | bc)
        MEM_TOTAL_GB=$(echo "scale=1; $MEM_TOTAL/1048576" | bc)

        SWAP_TOTAL=$(grep SwapTotal /proc/meminfo | awk '{print $2}')
        SWAP_FREE=$(grep SwapFree /proc/meminfo  | awk '{print $2}')
        SWAP_USED_KB=$(( SWAP_TOTAL - SWAP_FREE ))
        (( SWAP_TOTAL > 0 )) && SWAP_PCT=$(( SWAP_USED_KB * 100 / SWAP_TOTAL )) || SWAP_PCT=0

        GPU=$(get_gpu_usage)
        VRAM=$(get_gpu_vram)
        read -r NET_RX NET_TX NET_IFACE <<< "$(get_net_speed)"

        DISK_PCT=$(df / | awk 'NR==2{print int($5)}' | tr -d '%')
        TEMP=$(sensors 2>/dev/null | grep -E "Core 0|Package id|Tctl" | head -1 | \
               grep -o '+[0-9]*\.' | head -1 | tr -d '+.' || echo "0")
        LOAD=$(cat /proc/loadavg | cut -d' ' -f1-3)
        TIME=$(date '+%H:%M:%S')
        DATE=$(date '+%a %d %b %Y')

        # Update history
        CPU_HIST+=("$CPU"); (( ${#CPU_HIST[@]} > 20 )) && CPU_HIST=("${CPU_HIST[@]:1}")
        MEM_HIST+=("$MEM_PCT"); (( ${#MEM_HIST[@]} > 20 )) && MEM_HIST=("${MEM_HIST[@]:1}")

        # ── Render ──────────────────────────────────────────────────────────────
        tput cup 0 0
        local cols
        cols=$(tput cols)

        echo -e "${MINT}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
        printf "${MINT}${BOLD}║${NC}  %-24s  ${MINT}MINT OS DASH${NC}  %19s  ${MINT}${BOLD}║${NC}\n" "$DATE" "$TIME"
        echo -e "${MINT}${BOLD}╠══════════════════════════════════════════════════════════════╣${NC}"

        # CPU Row
        printf "${MINT}${BOLD}║${NC}  CPU  $(bar "$CPU" 28)  %3d%%  $(sparkline CPU_HIST)  ${MINT}${BOLD}║${NC}\n" "$CPU"

        # Memory Row
        printf "${MINT}${BOLD}║${NC}  RAM  $(bar "$MEM_PCT" 28)  %3d%%  ${DIM}${MEM_GB}/${MEM_TOTAL_GB}GB${NC}     ${MINT}${BOLD}║${NC}\n" "$MEM_PCT"

        # Swap Row
        printf "${MINT}${BOLD}║${NC}  SWP  $(bar "$SWAP_PCT" 28)  %3d%%  ${DIM}zram${NC}              ${MINT}${BOLD}║${NC}\n" "$SWAP_PCT"

        # GPU Row
        if [[ "$GPU" != "N/A" ]]; then
            printf "${MINT}${BOLD}║${NC}  GPU  $(bar "$GPU" 28)  %3d%%  ${DIM}vram:${VRAM}%%${NC}         ${MINT}${BOLD}║${NC}\n" "$GPU"
        else
            printf "${MINT}${BOLD}║${NC}  GPU  ${DIM}%-44s${NC}  ${MINT}${BOLD}║${NC}\n" "No GPU metrics available"
        fi

        # Disk Row
        printf "${MINT}${BOLD}║${NC}  DSK  $(bar "$DISK_PCT" 28)  %3d%%  ${DIM}root${NC}              ${MINT}${BOLD}║${NC}\n" "$DISK_PCT"

        echo -e "${MINT}${BOLD}╠══════════════════════════════════════════════════════════════╣${NC}"

        # Network Row
        printf "${MINT}${BOLD}║${NC}  NET  ${CYAN}↓ %-10s${NC}  ${MINT}↑ %-10s${NC}  ${DIM}%s${NC}             ${MINT}${BOLD}║${NC}\n" \
            "$(format_bytes "$NET_RX")/s" "$(format_bytes "$NET_TX")/s" "$NET_IFACE"

        # Temperature + Load
        printf "${MINT}${BOLD}║${NC}  TMP  ${YELLOW}%-6s°C${NC}  LOAD  ${DIM}%-20s${NC}              ${MINT}${BOLD}║${NC}\n" \
            "$TEMP" "$LOAD"

        echo -e "${MINT}${BOLD}╠══════════════════════════════════════════════════════════════╣${NC}"

        # Top processes
        printf "${MINT}${BOLD}║${NC}  ${DIM}TOP PROCESSES                                              ${MINT}${BOLD}║${NC}\n"
        ps aux --sort=-%cpu | awk 'NR>1 && NR<5{
            name=$11; sub(".*/","",name)
            printf "  %-20s  CPU: %5s%%  RAM: %5s%%\n", name, $3, $4
        }' | while read -r line; do
            printf "${MINT}${BOLD}║${NC}  %-60s${MINT}${BOLD}║${NC}\n" "$line"
        done

        echo -e "${MINT}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}"
        printf "  ${DIM}Refreshing every ${INTERVAL}s — Press Ctrl+C to exit | mint-ai for AI insights${NC}\n"

        sleep "$INTERVAL"
    done
}

# Clear screen for full dashboard
clear
dashboard
