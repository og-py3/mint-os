#!/usr/bin/env bash
# =============================================================================
# Mint OS — mint-adaptive  |  Intelligent auto-tuning daemon
# Watches workload patterns and silently optimizes in real-time
# =============================================================================
set -euo pipefail

DAEMON_MODE="${1:---daemon}"
PID_FILE="/var/run/mint-adaptive.pid"
STATE_DIR="/var/lib/mint-adaptive"; mkdir -p "$STATE_DIR"
LOG_DIR="/var/log/mint-os"; mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/mint-adaptive.log"
PROFILE_FILE="$STATE_DIR/current-profile"
LEARNED_FILE="$STATE_DIR/learned-patterns.tsv"

MINT='\033[38;2;46;203;113m'; BOLD='\033[1m'; NC='\033[0m'
DIM='\033[2m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'

log()  { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"; }
info() { echo -e "${MINT}[ADAPT]${NC} $*"; }

# ── Profile Definitions ───────────────────────────────────────────────────────
declare -A PROFILES=(
    [idle]="swappiness=60 governor=powersave thp=always"
    [normal]="swappiness=10 governor=schedutil thp=madvise"
    [performance]="swappiness=5 governor=performance thp=madvise"
    [gaming]="swappiness=1 governor=performance thp=never"
    [battery]="swappiness=60 governor=powersave thp=always"
    [thermal]="swappiness=20 governor=schedutil thp=madvise"
)

CURRENT_PROFILE="normal"

# ── Apply Profile ─────────────────────────────────────────────────────────────
apply_profile() {
    local profile="$1"
    [[ "$profile" == "$CURRENT_PROFILE" ]] && return 0

    log "Profile change: $CURRENT_PROFILE → $profile"
    CURRENT_PROFILE="$profile"
    echo "$profile" > "$PROFILE_FILE"

    # Parse profile string
    local swappiness governor thp
    IFS=' ' read -r sw_raw gov_raw thp_raw <<< "${PROFILES[$profile]}"
    swappiness="${sw_raw#*=}"
    governor="${gov_raw#*=}"
    thp="${thp_raw#*=}"

    # Apply CPU governor
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        echo "$governor" > "$cpu" 2>/dev/null || true
    done

    # Apply swappiness
    sysctl -w vm.swappiness="$swappiness" > /dev/null 2>/dev/null || true

    # Apply THP
    echo "$thp" > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true

    # Profile-specific extras
    case "$profile" in
        gaming)
            sysctl -w vm.max_map_count=2147483642 > /dev/null 2>/dev/null || true
            sysctl -w kernel.split_lock_mitigate=0 > /dev/null 2>/dev/null || true
            ;;
        battery)
            for f in /sys/class/net/wl*/device/power/control; do
                echo auto > "$f" 2>/dev/null || true
            done
            for disk in /dev/sd?; do
                [[ -b "$disk" ]] && hdparm -B 96 -S 12 "$disk" 2>/dev/null || true
            done
            ;;
        thermal)
            # Reduce all frequencies slightly to cut heat
            for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq; do
                local base_max
                base_max=$(cat "${f/scaling_max/cpuinfo_max}" 2>/dev/null || continue)
                echo "$(( base_max * 80 / 100 ))" > "$f" 2>/dev/null || true
            done
            ;;
        normal)
            # Restore any throttled frequencies
            for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq; do
                local base_max
                base_max=$(cat "${f/scaling_max/cpuinfo_max}" 2>/dev/null || continue)
                echo "$base_max" > "$f" 2>/dev/null || true
            done
            sysctl -w vm.max_map_count=2147483642 > /dev/null 2>/dev/null || true
            sysctl -w kernel.split_lock_mitigate=0 > /dev/null 2>/dev/null || true
            ;;
    esac
}

# ── Workload Detector ─────────────────────────────────────────────────────────
detect_workload() {
    # Gather metrics
    local cpu_pct
    cpu_pct=$(top -bn1 | grep "Cpu(s)" | awk '{print int($2)}' 2>/dev/null || echo "0")
    local mem_pct
    mem_pct=$(free | awk '/Mem:/{printf "%.0f", $3/$2*100}' 2>/dev/null || echo "0")
    local temp
    temp=$(sensors 2>/dev/null | grep -E "Core 0|Package|Tctl" | head -1 | \
           grep -o '+[0-9]*\.' | head -1 | tr -d '+.' || echo "0")
    local on_battery=false
    [[ -f /sys/class/power_supply/AC/online ]] && \
        [[ "$(cat /sys/class/power_supply/AC/online 2>/dev/null)" == "0" ]] && on_battery=true

    # Detect running game/steam
    local gaming_active=false
    pgrep -x "steam\|wine\|gamemoderun\|lutris\|heroic" &>/dev/null && gaming_active=true
    [[ -f /tmp/mint-gaming-mode-active ]] && gaming_active=true

    # Log patterns for learning
    local hour
    hour=$(date +%H)
    echo -e "${hour}\t${cpu_pct}\t${mem_pct}\t${gaming_active}\t${on_battery}\t$CURRENT_PROFILE" \
        >> "$LEARNED_FILE" 2>/dev/null || true

    # ── Decision Logic ─────────────────────────────────────────────────────
    local new_profile="normal"

    # Thermal emergency (overrides everything)
    if (( temp > 92 )); then
        new_profile="thermal"
        log "THERMAL EMERGENCY: ${temp}°C — throttling"

    # On battery
    elif [[ "$on_battery" == "true" ]]; then
        if (( cpu_pct > 60 )); then
            new_profile="normal"    # Working on battery — balanced
        else
            new_profile="battery"   # Light use on battery
        fi

    # Gaming detected
    elif [[ "$gaming_active" == "true" ]]; then
        new_profile="gaming"

    # Heavy workload
    elif (( cpu_pct > 75 || mem_pct > 85 )); then
        new_profile="performance"

    # Idle
    elif (( cpu_pct < 5 )); then
        # Check time — don't switch to idle if user probably just stepped away briefly
        local uptime_min
        uptime_min=$(cat /proc/uptime | awk '{print int($1/60)}')
        (( uptime_min > 5 )) && new_profile="idle" || new_profile="normal"

    else
        new_profile="normal"
    fi

    apply_profile "$new_profile"
    echo "$cpu_pct $mem_pct $temp $gaming_active $on_battery $new_profile"
}

# ── Daemon Mode ───────────────────────────────────────────────────────────────
run_daemon() {
    [[ "$EUID" -eq 0 ]] || { echo "Run as root: sudo mint-adaptive --daemon"; exit 1; }

    echo $$ > "$PID_FILE"
    log "Mint OS Adaptive daemon started (PID: $$)"

    # Initial profile
    apply_profile "normal"

    local check_interval=10  # seconds between checks

    while true; do
        read -r cpu mem temp gaming battery profile <<< "$(detect_workload)"
        log "CPU:${cpu}% MEM:${mem}% TEMP:${temp}°C GAME:${gaming} BAT:${battery} → $profile"
        sleep "$check_interval"
    done
}

# ── Status Display ─────────────────────────────────────────────────────────────
show_status() {
    echo -e "${MINT}${BOLD}Mint OS Adaptive Engine${NC}"
    echo ""
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        echo -e "  Status:  ${MINT}Running${NC} (PID: $pid)"
    else
        echo -e "  Status:  ${DIM}Stopped${NC}"
    fi

    local current
    current=$(cat "$PROFILE_FILE" 2>/dev/null || echo "unknown")
    echo -e "  Profile: ${BOLD}$current${NC}"
    echo ""
    echo -e "  ${DIM}Current system:${NC}"
    echo "    CPU: $(top -bn1 | grep "Cpu(s)" | awk '{print int($2)}')%"
    echo "    RAM: $(free | awk '/Mem:/{printf "%.0f", $3/$2*100}')%"
    echo "    Governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo N/A)"
    echo "    THP: $(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | grep -o '\[.*\]' | tr -d '[]' || echo N/A)"
    echo ""
    if [[ -f "$LEARNED_FILE" ]]; then
        echo -e "  ${DIM}Learning: $(wc -l < "$LEARNED_FILE") data points collected${NC}"
    fi
}

# ── Install as systemd service ─────────────────────────────────────────────────
install_service() {
    cat > /etc/systemd/system/mint-adaptive.service <<UNIT
[Unit]
Description=Mint OS Adaptive Performance Engine
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mint-adaptive --daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable --now mint-adaptive
    echo -e "${MINT}Mint Adaptive daemon installed and started.${NC}"
}

main() {
    case "${1:---status}" in
        --daemon|-d)    run_daemon ;;
        --status|-s)    show_status ;;
        --install)      [[ "$EUID" -eq 0 ]] || { echo "Requires root"; exit 1; }; install_service ;;
        --stop)         kill "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null && echo "Stopped." || echo "Not running." ;;
        --profile)      [[ -n "${2:-}" ]] && apply_profile "$2" || echo "Profiles: ${!PROFILES[*]}" ;;
        --help|-h)
            echo "Usage: sudo mint-adaptive [--daemon|--status|--install|--stop|--profile <name>]"
            echo "Profiles: ${!PROFILES[*]}"
            ;;
        *) show_status ;;
    esac
}

main "$@"
