#!/usr/bin/env bash
# =============================================================================
# Mint OS — mint-privacy-center  |  Comprehensive privacy dashboard
# Visual per-app permission manager + firewall + DNS + telemetry controls
# =============================================================================
set -euo pipefail

MINT='\033[38;2;46;203;113m'; BOLD='\033[1m'; NC='\033[0m'
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; DIM='\033[2m'
LOG_DIR="/var/log/mint-os"; mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/privacy-$(date +%Y%m%d).log"

ok()      { echo -e "  ${GREEN}[✓]${NC} $*" | tee -a "$LOG"; }
warn()    { echo -e "  ${YELLOW}[!]${NC} $*" | tee -a "$LOG"; }
fail()    { echo -e "  ${RED}[✗]${NC} $*" | tee -a "$LOG"; }
info()    { echo -e "  ${MINT}[+]${NC} $*" | tee -a "$LOG"; }
section() { echo -e "\n${BOLD}${CYAN}━━ $* ━━${NC}"; }

check_root() { [[ "$EUID" -eq 0 ]] || { echo "Run as root: sudo mint-privacy-center"; exit 1; }; }

banner() {
    clear
    echo -e "${MINT}${BOLD}"
    echo "  ╔══════════════════════════════════════════════════════╗"
    echo "  ║   Mint OS Privacy Center                            ║"
    echo "  ║   Zero telemetry · Local AI · Full control          ║"
    echo "  ╚══════════════════════════════════════════════════════╝${NC}"
    echo ""
}

# ── Privacy Audit ─────────────────────────────────────────────────────────────
audit_privacy() {
    section "Privacy Audit"

    # Firewall
    if systemctl is-active --quiet ufw 2>/dev/null; then
        local ufw_status
        ufw_status=$(ufw status 2>/dev/null | head -1)
        echo "$ufw_status" | grep -q "active" && ok "Firewall (UFW): active" || fail "Firewall inactive"
    else
        fail "Firewall not running"
    fi

    # AppArmor
    if aa-status 2>/dev/null | grep -q "profiles are in enforce mode"; then
        local enforced
        enforced=$(aa-status 2>/dev/null | grep "enforce" | awk '{print $1}')
        ok "AppArmor: $enforced profiles enforcing"
    else
        warn "AppArmor: not enforcing"
    fi

    # DNS check
    local dns_current
    dns_current=$(resolvectl status 2>/dev/null | grep "DNS Server" | head -1 | awk '{print $NF}' || \
                  cat /etc/resolv.conf 2>/dev/null | grep nameserver | head -1 | awk '{print $2}' || echo "unknown")
    local private_dns=("1.1.1.1" "1.0.0.1" "9.9.9.9" "149.112.112.112" "94.140.14.14" "127.0.0.53")
    local dns_ok=false
    for d in "${private_dns[@]}"; do [[ "$dns_current" == "$d" ]] && dns_ok=true; done
    $dns_ok && ok "DNS: $dns_current (privacy-respecting)" || warn "DNS: $dns_current (consider DoH)"

    # SSH
    if systemctl is-active --quiet sshd 2>/dev/null; then
        local ssh_port
        ssh_port=$(grep "^Port" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' || echo "22")
        warn "SSH daemon running on port $ssh_port"
    else
        ok "SSH daemon: not running (good for desktops)"
    fi

    # MAC randomization
    if grep -q "ethernet.cloned-mac-address=random" /etc/NetworkManager/conf.d/*.conf 2>/dev/null; then
        ok "MAC randomization: enabled"
    else
        warn "MAC randomization: not configured"
    fi

    # Check for telemetry processes
    local telemetry_procs=("apport" "ubuntu-report" "whoopsie" "kerneloops" "packagekit")
    local found_telemetry=false
    for proc in "${telemetry_procs[@]}"; do
        pgrep -x "$proc" &>/dev/null && warn "Telemetry process running: $proc" && found_telemetry=true
    done
    $found_telemetry || ok "No known telemetry processes running"

    # Listening ports
    local open_ports
    open_ports=$(ss -tlnp 2>/dev/null | grep LISTEN | wc -l)
    if (( open_ports <= 3 )); then
        ok "Open ports: $open_ports (minimal exposure)"
    else
        warn "Open ports: $open_ports — run 'ss -tlnp' to review"
    fi

    # Check camera/mic access
    if command -v v4l2-ctl &>/dev/null; then
        local cameras
        cameras=$(v4l2-ctl --list-devices 2>/dev/null | grep -c "/dev/video" || echo "0")
        (( cameras > 0 )) && info "Camera devices: $cameras (check if expected)" || ok "No camera devices found"
    fi
}

# ── Firewall Management ────────────────────────────────────────────────────────
configure_firewall() {
    section "Firewall Configuration"
    echo ""
    echo "  Current status:"
    ufw status verbose 2>/dev/null | head -15 || echo "  UFW not configured"
    echo ""
    echo "  1) Enable firewall (deny all in, allow all out)"
    echo "  2) Allow SSH (port 22)"
    echo "  3) Allow KDE Connect (ports 1714-1764)"
    echo "  4) Block all incoming (max privacy)"
    echo "  5) Show current rules"
    echo "  B) Back"
    echo ""
    read -r -p "  Choice: " c
    case "$c" in
        1) ufw default deny incoming && ufw default allow outgoing && ufw --force enable && ok "Firewall enabled" ;;
        2) ufw allow ssh && ok "SSH allowed" ;;
        3) ufw allow 1714:1764/tcp && ufw allow 1714:1764/udp && ok "KDE Connect allowed" ;;
        4) ufw default deny incoming && ufw default deny outgoing && \
           ufw allow out 443 && ufw allow out 80 && ufw allow out 53 && \
           ufw --force enable && ok "Maximum restriction applied" ;;
        5) ufw status numbered ;;
        [Bb]) return ;;
    esac
}

# ── DNS Configuration ─────────────────────────────────────────────────────────
configure_dns() {
    section "DNS Privacy"
    echo ""
    echo "  Select DNS provider:"
    echo ""
    echo "  1) Cloudflare   1.1.1.1  (fast, privacy-first, no logs)"
    echo "  2) Quad9        9.9.9.9  (security-focused, malware blocking)"
    echo "  3) NextDNS      custom   (advanced filtering, family-safe)"
    echo "  4) AdGuard      94.140.14.14  (ad blocking built-in)"
    echo "  5) Mullvad      194.242.2.2  (no logs, no filtering)"
    echo "  6) Keep current"
    echo ""
    read -r -p "  Choice: " dns_choice

    local dns1 dns2 dns_name
    case "$dns_choice" in
        1) dns1="1.1.1.1";       dns2="1.0.0.1";       dns_name="Cloudflare" ;;
        2) dns1="9.9.9.9";       dns2="149.112.112.112"; dns_name="Quad9" ;;
        3) dns1="45.90.28.0";    dns2="45.90.30.0";      dns_name="NextDNS" ;;
        4) dns1="94.140.14.14";  dns2="94.140.15.15";    dns_name="AdGuard" ;;
        5) dns1="194.242.2.2";   dns2="193.19.108.2";    dns_name="Mullvad" ;;
        6) info "DNS unchanged."; return ;;
        *) warn "Invalid choice."; return ;;
    esac

    # Apply via NetworkManager
    if command -v nmcli &>/dev/null; then
        local active_conn
        active_conn=$(nmcli -t -f NAME c show --active | head -1)
        if [[ -n "$active_conn" ]]; then
            nmcli connection modify "$active_conn" \
                ipv4.dns "$dns1 $dns2" \
                ipv4.ignore-auto-dns yes 2>/dev/null && \
            nmcli connection up "$active_conn" 2>/dev/null || true
        fi
    fi

    # Also write resolv.conf as fallback
    cat > /etc/resolv.conf <<EOF
# Mint OS — $dns_name DNS
nameserver $dns1
nameserver $dns2
options edns0 trust-ad
EOF
    chattr +i /etc/resolv.conf 2>/dev/null || true  # protect from overwrite

    ok "DNS configured: $dns_name ($dns1, $dns2)"
}

# ── AppArmor ──────────────────────────────────────────────────────────────────
configure_apparmor() {
    section "AppArmor Profiles"
    echo ""
    aa-status 2>/dev/null | head -10 || warn "AppArmor not running"
    echo ""
    echo "  1) Enable AppArmor (enable + enforce all profiles)"
    echo "  2) Show all profiles"
    echo "  3) Show enforcing profiles"
    echo "  B) Back"
    echo ""
    read -r -p "  Choice: " c
    case "$c" in
        1) systemctl enable --now apparmor && aa-enforce /etc/apparmor.d/* 2>/dev/null && \
           ok "AppArmor enabled, all profiles enforcing" ;;
        2) aa-status 2>/dev/null ;;
        3) aa-status 2>/dev/null | grep "enforce" ;;
        [Bb]) return ;;
    esac
}

# ── MAC Randomization ─────────────────────────────────────────────────────────
configure_mac_randomization() {
    section "MAC Address Randomization"
    echo ""
    if grep -q "cloned-mac-address=random" /etc/NetworkManager/conf.d/mintos.conf 2>/dev/null; then
        ok "MAC randomization already enabled"
    else
        info "Enabling MAC randomization..."
        mkdir -p /etc/NetworkManager/conf.d
        cat > /etc/NetworkManager/conf.d/mac-randomize.conf <<MAC
[connection]
ethernet.cloned-mac-address=random
wifi.cloned-mac-address=stable

[device]
wifi.scan-rand-mac-address=yes
MAC
        systemctl reload NetworkManager 2>/dev/null && ok "MAC randomization enabled" || warn "Apply on next connect"
    fi
}

# ── Telemetry Killswitch ──────────────────────────────────────────────────────
disable_telemetry() {
    section "Telemetry Killswitch"

    local killed=0
    local services=("apport" "whoopsie" "kerneloops" "ubuntu-report" "update-notifier")
    for svc in "${services[@]}"; do
        systemctl disable --now "$svc" 2>/dev/null && (( killed++ )) && ok "Disabled: $svc" || true
    done

    # Firefox telemetry (if exists)
    local ff_prefs="/usr/lib/firefox/browser/defaults/preferences/vendor.js"
    if [[ -f "$ff_prefs" ]]; then
        cat >> "$ff_prefs" <<FF
// Mint OS — Disable telemetry
pref("toolkit.telemetry.enabled", false);
pref("datareporting.healthreport.uploadEnabled", false);
pref("datareporting.policy.dataSubmissionEnabled", false);
pref("browser.crashReports.unsubmittedCheck.autoSubmit2", false);
FF
        ok "Firefox telemetry disabled"
    fi

    info "Telemetry control: $killed services disabled"
}

# ── Privacy Score ─────────────────────────────────────────────────────────────
privacy_score() {
    section "Privacy Score"
    local score=0
    local max=10

    systemctl is-active --quiet ufw 2>/dev/null && (( score++ ))
    ufw status 2>/dev/null | grep -q "active" && (( score++ ))
    aa-status 2>/dev/null | grep -q "enforce" && (( score++ ))
    grep -q "cloned-mac-address=random" /etc/NetworkManager/conf.d/*.conf 2>/dev/null && (( score++ ))
    ! systemctl is-active --quiet sshd 2>/dev/null && (( score++ )) || true
    ! pgrep -x "apport|whoopsie" &>/dev/null && (( score++ )) || true

    local dns_current
    dns_current=$(cat /etc/resolv.conf 2>/dev/null | grep nameserver | head -1 | awk '{print $2}' || echo "")
    case "$dns_current" in
        1.1.1.1|9.9.9.9|94.140.14.14|194.242.2.2) (( score++ )) ;;
    esac

    local open_ports
    open_ports=$(ss -tlnp 2>/dev/null | grep -c LISTEN || echo "99")
    (( open_ports <= 2 )) && (( score++ ))
    (( score >= 5 )) && (( score++ ))  # bonus for overall good posture

    echo ""
    local pct=$(( score * 100 / max ))
    printf "  Privacy Score: "
    for (( i=0; i<score; i++ ));   do echo -n -e "${MINT}█${NC}"; done
    for (( i=score; i<max; i++ )); do echo -n -e "${DIM}░${NC}"; done
    printf " ${BOLD}%d/10${NC} (%d%%)\n" "$score" "$pct"
    echo ""

    if   (( score >= 8 )); then echo -e "  ${MINT}${BOLD}Excellent!${NC} Your system is well-hardened."
    elif (( score >= 5 )); then echo -e "  ${YELLOW}${BOLD}Good.${NC} A few improvements available."
    else                        echo -e "  ${RED}${BOLD}Needs attention.${NC} Run the hardening options below."
    fi
}

# ── Full Hardening Wizard ─────────────────────────────────────────────────────
harden_all() {
    section "Full Privacy Hardening"
    info "Applying all recommended privacy settings..."

    # Firewall
    ufw default deny incoming && ufw default allow outgoing && ufw --force enable
    ok "Firewall enabled"

    # AppArmor
    systemctl enable --now apparmor 2>/dev/null || true
    aa-enforce /etc/apparmor.d/* 2>/dev/null || true
    ok "AppArmor enforcing"

    # MAC randomization
    configure_mac_randomization

    # Cloudflare DNS
    cat > /etc/resolv.conf <<EOF
nameserver 1.1.1.1
nameserver 1.0.0.1
EOF
    ok "DNS: Cloudflare"

    # Fail2ban
    systemctl enable --now fail2ban 2>/dev/null || true
    ok "Fail2ban enabled"

    # Disable telemetry
    disable_telemetry

    echo ""
    ok "Full hardening complete. Reboot recommended."
    privacy_score
}

# ── Main Menu ─────────────────────────────────────────────────────────────────
main_menu() {
    while true; do
        banner
        privacy_score
        echo ""
        echo "  ${BOLD}Controls:${NC}"
        echo ""
        echo "  1) Privacy Audit"
        echo "  2) Firewall Manager"
        echo "  3) DNS Privacy"
        echo "  4) AppArmor Profiles"
        echo "  5) MAC Randomization"
        echo "  6) Telemetry Killswitch"
        echo "  7) Full Privacy Hardening (all of the above)"
        echo "  Q) Quit"
        echo ""
        read -r -p "  Choice: " choice
        case "$choice" in
            1) audit_privacy; read -r -p "  Press Enter..."; ;;
            2) configure_firewall; read -r -p "  Press Enter..."; ;;
            3) configure_dns; read -r -p "  Press Enter..."; ;;
            4) configure_apparmor; read -r -p "  Press Enter..."; ;;
            5) configure_mac_randomization; read -r -p "  Press Enter..."; ;;
            6) disable_telemetry; read -r -p "  Press Enter..."; ;;
            7) harden_all; read -r -p "  Press Enter..."; ;;
            [Qq]) echo -e "${MINT}Goodbye.${NC}"; exit 0 ;;
            *) ;;
        esac
    done
}

main() {
    check_root
    case "${1:-menu}" in
        --audit)   audit_privacy ;;
        --harden)  harden_all ;;
        --score)   privacy_score ;;
        --dns)     configure_dns ;;
        --fw)      configure_firewall ;;
        menu|*)    main_menu ;;
    esac
}

main "$@"
