#!/usr/bin/env bash
# =============================================================================
# Mint OS — mint-rollback  |  Instant system rollback via Btrfs snapshots
# Visual timeline — select a point in time and restore in <30 seconds
# =============================================================================
set -euo pipefail

MINT='\033[38;2;46;203;113m'; BOLD='\033[1m'; NC='\033[0m'
DIM='\033[2m'; RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
LOG_DIR="/var/log/mint-os"; mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/rollback-$(date +%Y%m%d-%H%M%S).log"

ok()      { echo -e "${GREEN}[✓]${NC} $*" | tee -a "$LOG"; }
info()    { echo -e "${MINT}[+]${NC} $*" | tee -a "$LOG"; }
warn()    { echo -e "${YELLOW}[!]${NC} $*" | tee -a "$LOG"; }
error()   { echo -e "${RED}[✗]${NC} $*" | tee -a "$LOG"; }
section() { echo -e "\n${BOLD}${CYAN}── $* ──${NC}"; }

check_root() { [[ "$EUID" -eq 0 ]] || { echo "Run as root: sudo mint-rollback"; exit 1; }; }

check_btrfs() {
    if ! findmnt -n -o FSTYPE / | grep -q btrfs; then
        error "Root filesystem is not Btrfs. Rollback requires Btrfs."
        echo "  Your filesystem: $(findmnt -n -o FSTYPE /)"
        echo "  To use rollback, reinstall Mint OS selecting Btrfs."
        exit 1
    fi
}

check_snapper() {
    if ! command -v snapper &>/dev/null; then
        error "Snapper not installed."
        echo "  Install: sudo pacman -S snapper"
        echo "  Then:    sudo snapper -c root create-config /"
        exit 1
    fi
    if ! snapper -c root list &>/dev/null; then
        warn "No snapper config found. Creating..."
        snapper -c root create-config /
        ok "Snapper config created."
    fi
}

banner() {
    clear
    echo -e "${MINT}${BOLD}"
    echo "  ╔══════════════════════════════════════════════════════╗"
    echo "  ║   Mint OS Instant Rollback                          ║"
    echo "  ║   Btrfs time-travel — restore in <30 seconds        ║"
    echo "  ╚══════════════════════════════════════════════════════╝${NC}"
    echo ""
}

# ── List snapshots as a visual timeline ───────────────────────────────────────
show_timeline() {
    section "System Timeline"
    echo ""

    local snapshots
    mapfile -t snapshots < <(snapper -c root list --columns number,date,description,type 2>/dev/null | tail -n +3 | grep -v "^$")

    if [[ ${#snapshots[@]} -eq 0 ]]; then
        warn "No snapshots found."
        echo "  Create one: sudo snapper -c root create --description 'manual'"
        return 1
    fi

    echo -e "  ${BOLD}#   Date/Time            Description                    Type${NC}"
    echo -e "  ${DIM}────────────────────────────────────────────────────────────${NC}"
    echo ""

    local now_ts
    now_ts=$(date +%s)
    local count=0
    for snap in "${snapshots[@]}"; do
        local num date_str desc type
        read -r num date_str _ time_str desc type <<< "$snap" 2>/dev/null || continue
        local snap_dt="${date_str} ${time_str}"

        # Compute age
        local snap_ts
        snap_ts=$(date -d "$snap_dt" +%s 2>/dev/null || echo "$now_ts")
        local age_sec=$(( now_ts - snap_ts ))
        local age_str
        if   (( age_sec < 3600 ));   then age_str="${age_sec}s ago"
        elif (( age_sec < 86400 ));  then age_str="$(( age_sec/3600 ))h ago"
        elif (( age_sec < 604800 )); then age_str="$(( age_sec/86400 ))d ago"
        else                              age_str="$(( age_sec/604800 ))w ago"
        fi

        # Color by age
        local color
        if   (( age_sec < 3600 ));   then color="${MINT}"
        elif (( age_sec < 86400 ));  then color="${CYAN}"
        elif (( age_sec < 604800 )); then color="${YELLOW}"
        else                              color="${DIM}"
        fi

        printf "  ${color}%-4s${NC}  %-20s  %-30s  ${DIM}%s${NC}  %s\n" \
            "$num" "$snap_dt" "${desc:0:30}" "$type" "$age_str"
        (( count++ ))
    done

    echo ""
    echo -e "  Total: ${BOLD}$count snapshots${NC}"
    echo ""
    return 0
}

# ── Create snapshot ────────────────────────────────────────────────────────────
create_snapshot() {
    local desc="${1:-Manual snapshot $(date '+%Y-%m-%d %H:%M')}"
    info "Creating snapshot: $desc"
    snapper -c root create --description "$desc" --cleanup-algorithm number
    ok "Snapshot created: $desc"
}

# ── Restore snapshot ───────────────────────────────────────────────────────────
restore_snapshot() {
    local num="$1"

    # Verify snapshot exists
    snapper -c root list 2>/dev/null | grep -q "^${num} " || \
    snapper -c root list 2>/dev/null | grep -q "^ *${num}[[:space:]]" || {
        error "Snapshot #$num not found."
        return 1
    }

    echo ""
    warn "About to restore snapshot #$num"
    warn "This will revert your system to that point in time."
    warn "Your current system state will be saved as a snapshot first."
    echo ""
    read -r -p "  Type 'yes' to confirm restore: " confirm
    [[ "$confirm" == "yes" ]] || { info "Restore cancelled."; return 0; }

    section "Restoring Snapshot #$num"

    # First, snapshot the current state
    local pre_desc="Pre-rollback: was at $(date '+%Y-%m-%d %H:%M')"
    info "Saving current state: $pre_desc"
    snapper -c root create --description "$pre_desc" --cleanup-algorithm number

    # Get snapshot path
    local snap_path
    snap_path=$(snapper -c root list 2>/dev/null | awk -v num="$num" '$1==num{print $NF}' || \
                ls "/.snapshots/${num}/snapshot" 2>/dev/null || echo "")

    if [[ -z "$snap_path" ]] || ! [[ -d "/.snapshots/${num}/snapshot" ]]; then
        snap_path="/.snapshots/${num}/snapshot"
    fi

    if ! [[ -d "$snap_path" ]]; then
        error "Snapshot directory not found: $snap_path"
        return 1
    fi

    info "Restoring from: $snap_path"

    # Create a new default subvolume from the snapshot
    local new_subvol="/@_rollback_$(date +%Y%m%d_%H%M%S)"
    local mount_point
    mount_point=$(findmnt -n -o SOURCE / | xargs dirname 2>/dev/null || echo "/dev/sda2")

    # Use snapper rollback if available
    if snapper --help 2>/dev/null | grep -q "rollback"; then
        info "Using snapper rollback..."
        snapper -c root rollback "$num"
        ok "Rollback prepared. Reboot to apply."
    else
        # Manual Btrfs rollback
        info "Manual Btrfs rollback..."
        local root_device
        root_device=$(findmnt -n -o SOURCE /)
        local root_opts
        root_opts=$(findmnt -n -o OPTIONS /)
        local btrfs_mount
        btrfs_mount=$(mktemp -d)

        mount -t btrfs -o "${root_opts},subvolid=0" "$root_device" "$btrfs_mount"
        btrfs subvolume snapshot "$btrfs_mount/.snapshots/${num}/snapshot" \
            "$btrfs_mount/${new_subvol}"

        # Update the default subvolume
        local new_id
        new_id=$(btrfs subvolume list "$btrfs_mount" | grep "$new_subvol" | awk '{print $2}')
        btrfs subvolume set-default "$new_id" "$btrfs_mount"

        umount "$btrfs_mount"
        rmdir "$btrfs_mount"
        ok "New default subvolume set to snapshot #$num"
    fi

    echo ""
    echo -e "${MINT}${BOLD}╔════════════════════════════════════════╗${NC}"
    echo -e "${MINT}${BOLD}║  Rollback prepared successfully!       ║${NC}"
    echo -e "${MINT}${BOLD}║  Reboot to complete the restore.       ║${NC}"
    echo -e "${MINT}${BOLD}╚════════════════════════════════════════╝${NC}"
    echo ""
    read -r -p "  Reboot now? [y/N]: " reboot_now
    [[ "$reboot_now" =~ ^[Yy]$ ]] && reboot
}

# ── Delete snapshot ────────────────────────────────────────────────────────────
delete_snapshot() {
    local num="$1"
    read -r -p "  Delete snapshot #$num? [y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || return
    snapper -c root delete "$num" && ok "Snapshot #$num deleted." || error "Delete failed."
}

# ── Interactive menu ───────────────────────────────────────────────────────────
interactive_menu() {
    while true; do
        banner
        if ! show_timeline; then
            read -r -p "  Create first snapshot now? [Y/n]: " c
            [[ ! "$c" =~ ^[Nn]$ ]] && create_snapshot "Initial snapshot"
            continue
        fi

        echo "  ${BOLD}Options:${NC}"
        echo "  R <#>  — Restore to snapshot number"
        echo "  C      — Create snapshot now"
        echo "  D <#>  — Delete snapshot"
        echo "  Q      — Quit"
        echo ""
        read -r -p "  Command: " input

        local cmd arg
        cmd=$(echo "$input" | awk '{print toupper($1)}')
        arg=$(echo "$input" | awk '{print $2}')

        case "$cmd" in
            R) [[ -n "$arg" ]] && restore_snapshot "$arg" || warn "Usage: R <number>" ;;
            C) read -r -p "  Description: " desc; create_snapshot "${desc:-Manual snapshot}" ;;
            D) [[ -n "$arg" ]] && delete_snapshot "$arg" || warn "Usage: D <number>" ;;
            [Q]) echo -e "${MINT}Goodbye.${NC}"; exit 0 ;;
            *) warn "Unknown command: $cmd" ;;
        esac
        read -r -p "  Press Enter to continue..."
    done
}

main() {
    check_root
    check_btrfs
    check_snapper

    case "${1:-menu}" in
        --create|-c) create_snapshot "${2:-Manual snapshot $(date '+%Y-%m-%d %H:%M')}" ;;
        --restore|-r) [[ -n "${2:-}" ]] && restore_snapshot "$2" || { error "Usage: mint-rollback --restore <number>"; exit 1; } ;;
        --list|-l) show_timeline ;;
        --delete|-d) [[ -n "${2:-}" ]] && delete_snapshot "$2" || { error "Usage: mint-rollback --delete <number>"; exit 1; } ;;
        menu|*) banner; interactive_menu ;;
    esac
}

main "$@"
