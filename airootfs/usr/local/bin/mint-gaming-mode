#!/usr/bin/env bash
# =============================================================================
# Mint OS — mint-gaming-mode  |  Hybrid gaming mode — SteamOS-level optimization
# Activates a complete performance transformation for gaming sessions
# =============================================================================
set -euo pipefail

STATE_FILE="/var/lib/mint-os/gaming-mode.state"
LOG_DIR="/var/log/mint-os"; mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/gaming-mode.log"
mkdir -p /var/lib/mint-os 2>/dev/null || true

MINT='\033[38;2;46;203;113m'; BOLD='\033[1m'; NC='\033[0m'
YELLOW='\033[1;33m'; RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'

info()    { echo -e "${MINT}[GAME]${NC} $*" | tee -a "$LOG"; }
ok()      { echo -e "${GREEN}[GAME]${NC} $*" | tee -a "$LOG"; }
warn()    { echo -e "${YELLOW}[GAME]${NC} $*" | tee -a "$LOG"; }
section() { echo -e "\n${BOLD}${CYAN}── $* ──${NC}"; }

check_root() { [[ "$EUID" -eq 0 ]] || { echo "Run as root: sudo mint-gaming-mode"; exit 1; }; }

# ── Save current state ─────────────────────────────────────────────────────────
save_state() {
    mkdir -p "$(dirname "$STATE_FILE")"
    local gov
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "schedutil")
    local thp
    thp=$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | grep -o '\[.*\]' | tr -d '[]')
    cat > "$STATE_FILE" <<STATE
CPU_GOV=$gov
THP=$thp
SWAPPINESS=$(sysctl -n vm.swappiness 2>/dev/null || echo 10)
MAX_MAP=$(sysctl -n vm.max_map_count 2>/dev/null || echo 2147483642)
SPLIT_LOCK=$(sysctl -n kernel.split_lock_mitigate 2>/dev/null || echo 1)
TIMESTAMP=$(date +%s)
STATE
    ok "System state saved to $STATE_FILE"
}

# ── Restore previous state ────────────────────────────────────────────────────
restore_state() {
    [[ -f "$STATE_FILE" ]] || { warn "No saved state found."; return 1; }
    source "$STATE_FILE"

    # CPU governor
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        echo "$CPU_GOV" > "$cpu" 2>/dev/null || true
    done

    # Kernel params
    sysctl -w vm.swappiness="$SWAPPINESS" > /dev/null 2>&1 || true
    sysctl -w vm.max_map_count="$MAX_MAP"  > /dev/null 2>&1 || true
    sysctl -w kernel.split_lock_mitigate="$SPLIT_LOCK" > /dev/null 2>&1 || true
    echo "$THP" > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true

    # Re-enable zram swap
    swapon -a 2>/dev/null || true

    # Re-enable services
    systemctl start NetworkManager bluetooth 2>/dev/null || true
    systemctl start irqbalance 2>/dev/null || true

    # Stop gamemoded
    systemctl stop gamemoded 2>/dev/null || true

    rm -f "$STATE_FILE"
    ok "System restored to pre-gaming state."
}

enable_gaming() {
    section "Entering Mint OS Gaming Mode"
    save_state

    # ── 1. CPU: Maximum Performance ────────────────────────────────────────
    section "CPU Optimization"
    local applied=0
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        echo "performance" > "$cpu" 2>/dev/null && (( applied++ )) || true
    done
    ok "CPU governor → performance ($applied cores)"

    # Energy performance hint (Intel/AMD P-state)
    for f in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
        echo "performance" > "$f" 2>/dev/null || true
    done

    # Disable CPU frequency scaling limits if possible
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
        local max
        max=$(cat "${f/min/max}" 2>/dev/null || echo "")
        [[ -n "$max" ]] && echo "$max" > "$f" 2>/dev/null || true
    done
    ok "CPU frequency locked to maximum"

    # ── 2. Memory: Gaming Optimized ────────────────────────────────────────
    section "Memory Optimization"
    # Disable zram swap for gaming (reduces latency)
    swapoff -a 2>/dev/null || true
    ok "Swap disabled (reduces micro-stutter)"

    sysctl -w vm.swappiness=1 > /dev/null
    ok "Swappiness → 1 (RAM preferred)"

    sysctl -w vm.max_map_count=2147483642 > /dev/null
    ok "vm.max_map_count maximized (required by some games)"

    # THP disabled for gaming (can cause stutters)
    echo "never" > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
    ok "Transparent hugepages → never (reduces jitter)"

    # Drop caches once (frees RAM for games)
    sync && echo 3 > /proc/sys/vm/drop_caches && echo 0 > /proc/sys/vm/drop_caches
    ok "Memory caches cleared"

    # ── 3. Kernel: Low-Latency ─────────────────────────────────────────────
    section "Kernel Tuning"
    sysctl -w kernel.split_lock_mitigate=0 > /dev/null 2>/dev/null || true
    sysctl -w kernel.nmi_watchdog=0 > /dev/null 2>/dev/null || true
    ok "Kernel latency optimized"

    # ── 4. Network: Gaming Priority ────────────────────────────────────────
    section "Network Priority"
    local iface
    iface=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'dev \K\S+' | head -1 || echo "")
    if [[ -n "$iface" ]]; then
        # Lower latency for gaming (fq_codel)
        tc qdisc replace dev "$iface" root fq_codel 2>/dev/null && \
            ok "Network scheduler → fq_codel on $iface" || warn "Could not set network scheduler"
    fi

    # ── 5. GPU: Maximum Power ──────────────────────────────────────────────
    section "GPU Power"
    # NVIDIA
    if command -v nvidia-smi &>/dev/null; then
        nvidia-smi --persistence-mode=1 2>/dev/null && ok "NVIDIA persistence mode enabled" || true
        nvidia-smi --power-limit=$(nvidia-smi --query-gpu=power.max_limit --format=csv,noheader,nounits 2>/dev/null | head -1) 2>/dev/null || true
    fi
    # AMD
    for f in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        echo "high" > "$f" 2>/dev/null && ok "AMD GPU → high performance mode" || true
    done
    # Disable GPU runtime PM
    for f in /sys/class/drm/card*/device/power/control; do
        echo "on" > "$f" 2>/dev/null || true
    done
    ok "GPU power management disabled"

    # ── 6. Background Services: Suspended ─────────────────────────────────
    section "Background Services"
    local suspended=0
    local services=(bluetooth cups avahi-daemon)
    for svc in "${services[@]}"; do
        systemctl stop "$svc" 2>/dev/null && (( suspended++ )) || true
    done
    ok "Suspended $suspended non-essential services"

    # Stop IRQ balance — let game pin its own IRQs
    systemctl stop irqbalance 2>/dev/null || true
    ok "irqbalance stopped (for CPU affinity)"

    # ── 7. GameMode (Feral Interactive) ────────────────────────────────────
    section "GameMode"
    if command -v gamemoded &>/dev/null; then
        systemctl start gamemoded 2>/dev/null && ok "GameMode daemon started" || true
    elif command -v gamemoderun &>/dev/null; then
        ok "GameMode available — prefix your game: gamemoderun ./game"
    else
        warn "GameMode not installed. Install: sudo pacman -S gamemode"
        warn "Then relaunch with: gamemoderun steam"
    fi

    # ── 8. Notifications: Do Not Disturb ──────────────────────────────────
    section "Notifications"
    # KDE Plasma DND via dbus (if running)
    if command -v qdbus &>/dev/null; then
        qdbus org.freedesktop.Notifications /org/freedesktop/Notifications \
            Inhibit "mint-gaming-mode" "Gaming session active" '{}' 2>/dev/null || true
    fi
    ok "Notifications silenced"

    # ── 9. Mark state ──────────────────────────────────────────────────────
    echo "ACTIVE" > /tmp/mint-gaming-mode-active

    # ── Summary ────────────────────────────────────────────────────────────
    echo ""
    echo -e "${MINT}${BOLD}╔══════════════════════════════════════════╗${NC}"
    echo -e "${MINT}${BOLD}║  🎮  GAMING MODE: ACTIVE                 ║${NC}"
    echo -e "${MINT}${BOLD}╠══════════════════════════════════════════╣${NC}"
    echo -e "${MINT}${BOLD}║${NC}  CPU: performance governor (all cores)   ${MINT}${BOLD}║${NC}"
    echo -e "${MINT}${BOLD}║${NC}  RAM: swap off, max_map maximized        ${MINT}${BOLD}║${NC}"
    echo -e "${MINT}${BOLD}║${NC}  GPU: max power state, PM disabled       ${MINT}${BOLD}║${NC}"
    echo -e "${MINT}${BOLD}║${NC}  NET: fq_codel low-latency scheduler     ${MINT}${BOLD}║${NC}"
    echo -e "${MINT}${BOLD}║${NC}  SVC: non-essentials suspended           ${MINT}${BOLD}║${NC}"
    echo -e "${MINT}${BOLD}╠══════════════════════════════════════════╣${NC}"
    echo -e "${MINT}${BOLD}║${NC}  Exit: sudo mint-gaming-mode --off       ${MINT}${BOLD}║${NC}"
    echo -e "${MINT}${BOLD}╚══════════════════════════════════════════╝${NC}"
    echo ""
    ok "Gaming mode enabled. Good luck!"
}

disable_gaming() {
    section "Exiting Mint OS Gaming Mode"
    restore_state

    rm -f /tmp/mint-gaming-mode-active

    # Restore network scheduler
    local iface
    iface=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'dev \K\S+' | head -1 || echo "")
    [[ -n "$iface" ]] && tc qdisc del dev "$iface" root 2>/dev/null || true

    # NVIDIA: restore normal
    command -v nvidia-smi &>/dev/null && nvidia-smi --persistence-mode=0 2>/dev/null || true
    for f in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        echo "auto" > "$f" 2>/dev/null || true
    done

    # Re-enable notifications
    if command -v qdbus &>/dev/null; then
        qdbus org.freedesktop.Notifications /org/freedesktop/Notifications \
            UnInhibit 0 2>/dev/null || true
    fi

    echo ""
    echo -e "${GREEN}${BOLD}Gaming mode disabled. System restored to normal.${NC}"
}

status() {
    if [[ -f /tmp/mint-gaming-mode-active ]]; then
        echo -e "${MINT}${BOLD}Gaming mode: ACTIVE${NC}"
        echo ""
        echo "  CPU governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"
        echo "  Swappiness:   $(sysctl -n vm.swappiness 2>/dev/null)"
        echo "  THP:          $(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | grep -o '\[.*\]' | tr -d '[]')"
    else
        echo -e "${DIM}Gaming mode: inactive${NC}"
    fi
}

main() {
    check_root
    case "${1:---on}" in
        --on|--enable|-e|on)  enable_gaming ;;
        --off|--disable|-d|off) disable_gaming ;;
        --status|-s|status)   status ;;
        --toggle|-t)
            [[ -f /tmp/mint-gaming-mode-active ]] && disable_gaming || enable_gaming ;;
        --help|-h)
            echo "Usage: sudo mint-gaming-mode [--on|--off|--toggle|--status]"
            echo ""
            echo "  --on       Enable gaming mode (max performance)"
            echo "  --off      Disable gaming mode (restore system)"
            echo "  --toggle   Toggle on/off"
            echo "  --status   Show current state"
            ;;
        *) enable_gaming ;;
    esac
}

main "$@"
