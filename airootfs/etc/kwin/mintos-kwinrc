# Mint OS — KWin Configuration
# High-performance compositing with glassmorphism effects

[Compositing]
AnimationSpeed=3
Backend=OpenGL
Enabled=true
GLCore=true
HiddenPreviews=5
OpenGLIsUnsafe=false
WindowsBlockCompositing=false

[Effect-Blur]
BlurStrength=8
NoiseStrength=1

[Effect-MagicLamp]
AnimationDuration=250

[Effect-Slide]
HorizontalGap=0
VerticalGap=0
Duration=220

[Effect-DesktopGrid]
BorderActivate=0
LayoutMode=0

[Effect-Overview]
LayoutMode=0

[NightColor]
Active=true
Mode=Automatic
NightTemperature=4000

[Windows]
FocusPolicy=ClickToFocus
FocusStealingPreventionLevel=2
Placement=Smart
TitlebarDoubleClickCommand=MaximizeSetVertically

[Desktops]
Number=4
Rows=1

[Script-mintos-effects]
Enabled=true
